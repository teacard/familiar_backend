APP_NAME=Laravel
APP_ENV=develop
APP_KEY=${APP_KEY}
APP_DEBUG=false
APP_URL=https://${GAME_DOMAIN}
APP_TIMEZONE=Asia/Taipei

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=zh_TW
APP_FAKER_LOCALE=zh_TW

APP_MAINTENANCE_DRIVER=file

# Traefik 反向代理後信任所有代理，讓 Laravel 取得真實來源 IP/協定
TRUSTED_PROXIES=*

BCRYPT_ROUNDS=12

# 每天一個 log 檔，最多保留 7 天
LOG_CHANNEL=daily
LOG_MAX_FILES=7
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── 機密注入說明 ──────────────────────────────────────────────────────────
# 本檔由 game-docker 的 build-backend.yml 以 envsubst 從 GitHub Secrets 展開後
# 複製為 .env，僅展開下列變數：
#   ${APP_KEY} ${GAME_DOMAIN} ${GAME_DB_USER} ${GAME_DB_PASSWORD} ${BACKEND_ROOT_PASSWORD}
# 其餘 ${...}（如 ${APP_NAME}）保留給 Laravel 載入時自行展開。
# 非機密設定（host / port / db 名稱等）直接寫死，對齊 infra 拓樸。
DB_CONNECTION=pgsql
DB_HOST=infra_postgres
DB_PORT=5432
DB_DATABASE=game_db
DB_USERNAME=${GAME_DB_USER}
DB_PASSWORD=${GAME_DB_PASSWORD}
DB_SSLMODE=disable

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# ── 媒體儲存（medialibrary → 自家 MinIO 容器，S3 相容；非真實 AWS） ───────────
# 測試站媒體存於 docker repo（game-docker）內的 MinIO 容器，與 infra_postgres/redis 同網路。
# 待辦（docker repo）：1) 建立 MinIO service（infra_minio）與 bucket familiar-media；
#   2) 將下列機密 ${GAME_MINIO_ACCESS_KEY} ${GAME_MINIO_SECRET_KEY} 加入
#      build-backend.yml 的 envsubst 允許清單；3) 確認對外媒體公開 URL 路由（MINIO_URL）。
MEDIA_DISK=minio
MINIO_ACCESS_KEY=${GAME_MINIO_ACCESS_KEY}
MINIO_SECRET_KEY=${GAME_MINIO_SECRET_KEY}
MINIO_BUCKET=familiar-media
MINIO_ENDPOINT=http://infra_minio:9000
MINIO_URL=https://${GAME_DOMAIN}/media

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=infra_redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=familiar_

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Telescope（測試站啟用；正式環境應設為 false）
# APP_ENV=develop 已使 Telescope 記錄全部 entry（見 TelescopeServiceProvider）
TELESCOPE_ENABLED=true

# 後台 seeder 初始密碼（機密，envsubst 注入）
ADMIN_SEED_PASSWORD=${BACKEND_ROOT_PASSWORD}
